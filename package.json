{
  "name": "ocr-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:e2e": "cross-env NEXT_DIST_DIR=.next-e2e OCR_BACKEND_URL=http://127.0.0.1:4010 OCR_APP_ORIGINS=http://127.0.0.1:3001 OCR_BACKEND_TIMEOUT_MS=1200 next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome check src tests next.config.ts vitest.config.mts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:e2e",
    "fixture": "node tests/fixtures/ocr-backend.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cross-env": "10.1.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
